# Created by the Turso integration in the Vercel Marketplace.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Created when a private Vercel Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=

# Generate at least 32 random characters. Vercel sends it as a Bearer token
# when invoking /api/cron/maintenance.
CRON_SECRET=

# Optional online GIF search. Bundled GIFs work without this value.
TENOR_API_KEY=

# Generate at least 32 random characters. Used only to authenticate short-lived
# email verification codes; never expose it to browser code.
AUTH_SECRET=

# Exact deployed origin, without a trailing slash.
AUTH_PUBLIC_ORIGIN=https://witram.vercel.app

# Transactional email delivery for registration verification.
RESEND_API_KEY=
AUTH_EMAIL_FROM=Whisper <login@your-verified-domain.example>

# Optional Google OpenID Connect web client. The authorized redirect URI is
# AUTH_PUBLIC_ORIGIN followed by /api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated authenticated account user IDs allowed to access /api/operations.
OPS_ADMIN_USER_IDS=

# Optional HTTPS webhook receiving critical health/security alerts.
ALERT_WEBHOOK_URL=

# Optional privacy-preserving browser notifications. Generate the key pair with
# `npm run push:keys`, keep the private key secret, and replace the subject with
# a monitored mailto: address or an HTTPS origin you control.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:security@example.com
