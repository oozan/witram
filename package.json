{
  "name": "whisper-encrypted-chat",
  "version": "0.10.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "check:node": "node scripts/check-node-version.mjs",
    "predev": "npm run check:node",
    "dev": "next dev",
    "prebuild": "npm run check:node",
    "build": "next build --webpack",
    "prestart": "npm run check:node",
    "start": "next start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "push:keys": "node scripts/generate-vapid-keys.mjs",
    "security:baseline": "node scripts/security-baseline.mjs",
    "security:dependencies": "npm audit --omit=dev --audit-level=high",
    "security:probe": "node scripts/security-probe.mjs",
    "smoke:production": "node scripts/production-smoke.mjs",
    "smoke:load": "node scripts/load-smoke.mjs",
    "recovery:verify": "node scripts/verify-recovery.mjs",
    "incident:exercise": "node scripts/incident-exercise.mjs",
    "readiness:report": "node scripts/release-readiness.mjs",
    "release:gate": "node scripts/release-readiness.mjs --enforce",
    "security:review": "npm run security:baseline && npm run security:dependencies && npm run lint && npm test"
  },
  "dependencies": {
    "@hpke/chacha20poly1305": "1.7.1",
    "@hpke/dhkem-x448": "1.7.0",
    "@hpke/hybridkem-x-wing": "0.6.1",
    "@hpke/ml-kem": "0.2.1",
    "@libsql/client": "0.18.0",
    "@noble/ciphers": "2.1.1",
    "@noble/curves": "2.0.1",
    "@noble/hashes": "2.0.1",
    "@noble/post-quantum": "0.5.2",
    "@vercel/blob": "2.8.0",
    "drizzle-orm": "0.45.2",
    "next": "16.3.5",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "ts-mls": "1.6.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "tailwindcss": "4.2.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.59.3"
  },
  "type": "module"
}
